# =============================================================================
# DEMO credentials — replace every value marked DEMO / your-* with real secrets
# Copy to .env:  copy .env.example .env
# Desktop app:  python app_main.py   (pywebview SPA + Flask API/Telegram)
# Fallback UI:  UI_MODE=ctk
# Build exe:    powershell -File build_exe.ps1  → dist\UpottoForeman.exe
# Server only:  python webhook.py   (open http://127.0.0.1:5000/ in a browser)
# =============================================================================

# LLM — anthropic | openrouter | agentrouter
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-DEMO_replace_with_your_anthropic_api_key
OPENROUTER_API_KEY=sk-or-DEMO_replace_me
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=8192

# Target codebase — MUST stay under C:\langs\projects (hard sandbox in config.py)
# Prefer absolute paths like C:\langs\projects\frontend\my-app
PROJECT_DIR=C:\langs\projects\agents\upotto-foreman\target_project

LLM_RETRY_ATTEMPTS=3
LOG_LEVEL=INFO
# Docs-first bootstrap runs before the crew (EMPTY / audit / generate docs)
SKIP_BOOTSTRAP=false

# Telegram — ONLY chat_id 7877332152 can control the bot (hardcoded gate)
# App uses long-polling (TELEGRAM_POLLING=true) so ngrok is NOT required.
TELEGRAM_BOT_TOKEN=DEMO_telegram_bot_token_replace_me
TELEGRAM_CHAT_ID=7877332152
TELEGRAM_WEBHOOK_SECRET=DEMO_random_secret_for_telegram_replace_me
TELEGRAM_POLLING=true

# SMTP backup
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=demo.sender@gmail.com
SMTP_PASSWORD=DEMO_gmail_app_password_replace_me
SMTP_FROM=demo.sender@gmail.com
SMTP_TO=demo.receiver@gmail.com

# Flask (desktop uses 127.0.0.1; use 0.0.0.0 + ngrok for Telegram webhook)
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=5000
WEBHOOK_PUBLIC_URL=https://demo-ngrok-or-domain.example
FLASK_DEBUG=0

# Desktop shell: webview (default) | ctk
UI_MODE=webview
WEBVIEW_DEBUG=0

APPROVAL_WEBHOOK_SECRET=DEMO_random_secret_replace_me
