# =============================================================================
# DEMO credentials — replace every value marked DEMO / your-* with real secrets
# Copy to .env:  copy .env.example .env
# =============================================================================

# Anthropic (Claude via CrewAI's LLM wrapper) — ONLY paid item in this stack
ANTHROPIC_API_KEY=sk-ant-DEMO_replace_with_your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=8192

# Web search — free, no API key needed (DuckDuckGo via langchain_community)
# (SerperDevTool removed — was paid after 2500 free queries)

# Target codebase the agents work on
PROJECT_DIR=./target_project

# LLM retries / logging
LLM_RETRY_ATTEMPTS=3
LOG_LEVEL=INFO

# Skip CrewAI human_input prompt (useful for cron)
SKIP_HUMAN_INPUT=false

# Telegram Bot (free, replaces paid Twilio WhatsApp)
# 1. Message @BotFather on Telegram -> /newbot -> get token below
# 2. Message your new bot once, then GET https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat id
# 3. Generate a random secret for TELEGRAM_WEBHOOK_SECRET (see README step)
TELEGRAM_BOT_TOKEN=DEMO_telegram_bot_token_replace_me
TELEGRAM_CHAT_ID=DEMO_your_telegram_chat_id
TELEGRAM_WEBHOOK_SECRET=DEMO_random_secret_for_telegram_replace_me

# SMTP email (backup channel) — free with Gmail app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=demo.sender@gmail.com
SMTP_PASSWORD=DEMO_gmail_app_password_replace_me
SMTP_FROM=demo.sender@gmail.com
SMTP_TO=demo.receiver@gmail.com

# Flask approval webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=5000
WEBHOOK_PUBLIC_URL=https://demo-ngrok-or-domain.example
FLASK_DEBUG=0

# Shared secret required in X-Approval-Secret header for manual/API /approve calls
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APPROVAL_WEBHOOK_SECRET=DEMO_random_secret_replace_me
